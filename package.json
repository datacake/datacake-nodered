{
  "name": "node-red-contrib-datacake",
  "version": "1.0.0",
  "description": "Node-RED nodes for Datacake: subscribe to and publish device measurements via the Datacake MQTT broker",
  "author": "Lukas Klein <lukas@datacake.co>",
  "contributors": [
    "Simon Kemper <simon@datacake.de>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/datacake/datacake-nodered#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datacake/datacake-nodered.git"
  },
  "bugs": {
    "url": "https://github.com/datacake/datacake-nodered/issues"
  },
  "keywords": [
    "node-red",
    "datacake",
    "iot",
    "mqtt",
    "lorawan"
  ],
  "node-red": {
    "version": ">=3.1.0",
    "nodes": {
      "datacake-mqtt": "dist/datacake-mqtt.js",
      "datacake-configuration": "dist/datacake-configuration.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pretest": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "node scripts/run-tests.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^18.19.0",
    "@types/node-red": "^1.3.5",
    "aedes": "^0.51.3",
    "eslint": "^9.39.0",
    "node-red": "^5.0.8",
    "node-red-node-test-helper": "^0.3.6",
    "prettier": "^3.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
